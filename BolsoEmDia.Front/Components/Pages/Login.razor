@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Entrar — BolsoEmDia</PageTitle>

<div class="auth-container">
    <div class="card shadow-sm auth-card">
        <div class="card-body p-4 p-md-5">
            <p class="auth-eyebrow">BolsoEmDia</p>
            <h1 class="auth-title">Entrar</h1>
            <p class="text-muted mb-4">Acesse sua conta para ver o extrato.</p>

            @if (!string.IsNullOrWhiteSpace(Erro))
            {
                <div class="alert alert-danger" role="alert">@Erro</div>
            }

            <form method="post" action="/auth/login">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-3">
                    <label class="form-label" for="email">E-mail</label>
                    <input type="email" id="email" name="email" class="form-control" required autofocus />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>

            <p class="mt-4 mb-0 text-center">Não tem conta? <a href="/registrar">Cadastre-se</a></p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Erro { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
